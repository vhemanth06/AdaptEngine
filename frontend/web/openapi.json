 "components": {
  "schemas": {
   "ActivityInfo": {
    "properties": {
     "activity_id": {
      "type": "string",
      "title": "Activity Id"
     },
     "type": {
      "type": "string",
      "enum": [
       "LESSON",
       "EXERCISE"
      ],
      "title": "Type"
     },
     "target_concept": {
      "type": "string",
      "title": "Target Concept"
     },
     "duration": {
      "type": "integer",
      "title": "Duration"
     },
     "difficulty": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Difficulty"
     }
    },
    "type": "object",
    "required": [
     "activity_id",
     "type",
     "target_concept",
     "duration"
    ],
    "title": "ActivityInfo"
   },
   "ApproveRequest": {
    "properties": {
     "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]{0,40}$",
      "title": "Name"
     },
     "reviewer": {
      "type": "string",
      "maxLength": 80,
      "title": "Reviewer"
     }
    },
    "type": "object",
    "required": [
     "name",
     "reviewer"
    ],
    "title": "ApproveRequest"
   },
   "ConceptInfo": {
    "properties": {
     "concept_id": {
      "type": "string",
      "title": "Concept Id"
     },
     "description": {
      "type": "string",
      "title": "Description"
     },
     "prerequisites": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Prerequisites"
     },
     "depth": {
      "type": "integer",
      "title": "Depth"
     }
    },
    "type": "object",
    "required": [
     "concept_id",
     "description",
     "prerequisites",
     "depth"
    ],
    "title": "ConceptInfo"
   },
   "ConceptResult": {
    "properties": {
     "concept_id": {
      "type": "string",
      "title": "Concept Id"
     },
     "p": {
      "type": "number",
      "title": "P"
     },
     "n_items": {
      "type": "integer",
      "title": "N Items"
     },
     "stop_reason": {
      "type": "string",
      "title": "Stop Reason"
     },
     "inferred_from": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Inferred From"
     }
    },
    "type": "object",
    "required": [
     "concept_id",
     "p",
     "n_items",
     "stop_reason"
    ],
    "title": "ConceptResult"
   },
   "ConceptState": {
    "properties": {
     "concept_id": {
      "type": "string",
      "title": "Concept Id"
     },
     "p": {
      "type": "number",
      "title": "P"
     },
     "responses": {
      "type": "integer",
      "title": "Responses"
     },
     "lessons_done": {
      "type": "integer",
      "title": "Lessons Done"
     },
     "status": {
      "type": "string",
      "title": "Status"
     },
     "evidence_mastered": {
      "type": "boolean",
      "title": "Evidence Mastered"
     },
     "needs_remediation": {
      "type": "boolean",
      "title": "Needs Remediation"
     }
    },
    "type": "object",
    "required": [
     "concept_id",
     "p",
     "responses",
     "lessons_done",
     "status",
     "evidence_mastered",
     "needs_remediation"
    ],
    "title": "ConceptState"
   },
   "ConceptUpdate": {
    "properties": {
     "concept_id": {
      "type": "string",
      "title": "Concept Id"
     },
     "p_before": {
      "type": "number",
      "title": "P Before"
     },
     "p_after": {
      "type": "number",
      "title": "P After"
     },
     "correct": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Correct"
     },
     "needs_remediation": {
      "type": "boolean",
      "title": "Needs Remediation"
     },
     "evidence_mastered": {
      "type": "boolean",
      "title": "Evidence Mastered"
     },
     "explanation": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Explanation"
     }
    },
    "type": "object",
    "required": [
     "concept_id",
     "p_before",
     "p_after",
     "needs_remediation",
     "evidence_mastered"
    ],
    "title": "ConceptUpdate"
   },
   "ContextOut": {
    "properties": {
     "goal": {
      "type": "string",
      "title": "Goal"
     },
     "deadline_day": {
      "type": "integer",
      "title": "Deadline Day"
     },
     "budget": {
      "type": "integer",
      "title": "Budget"
     },
     "current_day": {
      "type": "integer",
      "title": "Current Day",
      "default": 1
     },
     "minutes_used_today": {
      "type": "integer",
      "title": "Minutes Used Today",
      "default": 0
     }
    },
    "type": "object",
    "required": [
     "goal",
     "deadline_day",
     "budget"
    ],
    "title": "ContextOut"
   },
   "CreateSession": {
    "properties": {
     "curriculum": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
      "title": "Curriculum"
     },
     "goal": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
      "title": "Goal"
     },
     "deadline_day": {
      "type": "integer",
      "maximum": 365.0,
      "minimum": 1.0,
      "title": "Deadline Day"
     },
     "budget": {
      "type": "integer",
      "maximum": 600.0,
      "minimum": 1.0,
      "title": "Budget"
     },
     "profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
      "title": "Profile",
      "default": "fitted_S1"
     },
     "rules": {
      "type": "string",
      "enum": [
       "product",
       "legacy"
